{
  "name": "@akg/schema",
  "version": "0.1.0",
  "description": "Zod validators, JSON Schema, and serialization for AKG",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "json-schema"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "generate-schema": "tsx src/generate-json-schema.ts"
  },
  "dependencies": {
    "@akg/types": "workspace:*",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
